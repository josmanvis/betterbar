{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BetterBar",
  "version": "0.11.1",
  "identifier": "com.betterbar.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BetterBar",
        "width": 600,
        "height": 80,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": true,
        "center": true,
        "x": 0,
        "y": 0,
        "shadow": false
      },
      {
        "label": "settings",
        "title": "BetterBar Settings",
        "url": "index.html#settings",
        "width": 1000,
        "height": 740,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": true,
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": true,
        "visible": false,
        "center": true,
        "shadow": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "12.0"
    },
    "category": "Utility",
    "shortDescription": "Customizable dock",
    "longDescription": "A minimal, monospace dock showing pinned apps, running apps, music controls, world clocks, battery status and third-party extensions.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ],
        "recommends": [
          "wmctrl",
          "xdotool",
          "x11-utils",
          "network-manager"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ],
        "recommends": [
          "wmctrl",
          "xdotool",
          "xorg-x11-utils",
          "NetworkManager"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
